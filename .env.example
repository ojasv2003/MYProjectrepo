# Google Gemini API key from https://aistudio.google.com/apikey
# In Cursor Cloud Agents, add this as a Secret named GEMINI_API_KEY
# (Dashboard → Environment / Secrets). Locally, copy this file to .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional alias accepted by PipelineAgent if GEMINI_API_KEY is unset
# GOOGLE_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
