# Cursor API key from https://cursor.com/dashboard/api
# In Cursor Cloud Agents, add this as a Secret named CURSOR_API_KEY
# (Dashboard → Cloud Agents / Secrets). Locally, copy this file to .env.
CURSOR_API_KEY=your_cursor_api_key_here

# Optional model override (must be available to your Cursor account)
# Examples: composer-2.5, auto-smart
CURSOR_MODEL=composer-2.5

# Optional overrides
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
